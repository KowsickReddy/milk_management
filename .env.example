# ── Frontend Environment Configuration ──
# Copy this file to .env and fill in your values

# Backend API URL (required for production)
# Set this to the URL of your deployed backend server
# Example: REACT_APP_API_URL=https://your-backend.onrender.com
REACT_APP_API_URL=http://localhost:5000

# Support Phone Number (optional, defaults to +91 9876543210)
# This is shown to customers on the Portal Support page
REACT_APP_SUPPORT_PHONE=+91 9876543210
